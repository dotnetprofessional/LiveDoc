{
  "name": "livedoc-monorepo",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:vitest": "pnpm --filter @swedevtools/livedoc-vitest test",
    "test:publish": "pnpm --filter @swedevtools/livedoc-vitest test:publish",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.13": "3.4.13",
      "mermaid@>=11.0.0-alpha.1 <11.16.1": "11.16.1",
      "shell-quote@<=1.8.4": "1.9.0",
      "websocket-driver@<0.7.5": "0.7.5",
      "webpack-dev-server@<=5.2.5": "5.2.6"
    }
  }
}
